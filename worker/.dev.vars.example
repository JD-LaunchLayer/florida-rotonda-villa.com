# Copy to worker/.dev.vars for local `wrangler dev`. Never commit .dev.vars.
# Production does not allow localhost until you set this for local preview only.
ALLOW_LOCALHOST=true

# Leave these unset until the sender domain is verified.
# EMAIL_API_KEY=
# EMAIL_FROM=Florida Rotonda Villa <bookings@florida-rotonda-villa.com>
# OWNER_EMAIL=
# Guest Reply-To. Leave unset to use OWNER_EMAIL.
# REPLY_TO=
# BANK_ACCOUNT_NAME=
# BANK_SORT_CODE=
# BANK_ACCOUNT_NUMBER=
# EMAIL_API_URL=https://api.resend.com/emails
# Approval links need a long random secret. Set it with:
# npx wrangler secret put APPROVAL_SECRET
# Do not write the value in this file.
